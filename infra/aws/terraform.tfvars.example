# =========================================================================
# SAMPLE TERRAFORM VARIABLE CONFIGURATION (AWS)
# =========================================================================
# Copy this file to terraform.tfvars and customize for your environment:
# cp terraform.tfvars.example terraform.tfvars

aws_region             = "ap-southeast-2"
environment            = "dev"
project_name           = "data-landing-platform"

landing_bucket_prefix  = "dataset-platform-landing"
frontend_bucket_prefix = "data-landing-platform-frontend"
ecr_repository_name    = "data-landing-platform"

db_name                = "metadata_db"
db_username            = "postgres"
db_password            = "DataLandingPass123!"
