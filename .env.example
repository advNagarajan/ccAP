# Google Cloud Base (Environment-Specific - optional if using Azure)
GCP_PROJECT_ID=your-gcp-project-id

# Azure Base & Services (Environment-Specific - when running on Azure)
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Azure Service Bus (Messaging)
AZURE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://your-sb-namespace.servicebus.windows.net/;SharedAccessKeyName=RootAppAccessPolicy;SharedAccessKey=your-key

# Azure Storage (Data Landing)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_LANDING_CONTAINER=landing

# Database (PostgreSQL - Works for both Local and Azure Flexible Server)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=metadata_db
DB_USER=your-database-user
DB_PASSWORD=your-database-password
# Google Cloud SQL connection name (Leave blank on Azure)
CLOUD_SQL_CONNECTION_NAME=

# Azure OpenAI (Optional - if replacing Vertex AI)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# Slack Notification Webhooks (Secrets)
SLACK_WEBHOOK_DEAD_LETTER=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_NEW_TABLE=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_JOB_COMPLETED=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_JOB_FAILED=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_QUALITY_CHECK=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH

# Notification Channels - SMTP (Email) Configurations (Secrets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
NOTIFICATION_EMAIL_SENDER=your-email@gmail.com

# Frontend API URL Configuration (Vite)
VITE_API_URL=http://localhost:8000

