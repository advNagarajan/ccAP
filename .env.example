# =========================================================================
# SMART DATA LANDING & SCHEMA INTELLIGENCE PLATFORM (.env)
# =========================================================================

# Master Cloud Switch: Set to "aws" or "gcp"
CLOUD_PROVIDER=aws

# -------------------------------------------------------------------------
# 1. AWS CONFIGURATION (Required when CLOUD_PROVIDER=aws)
# -------------------------------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_LANDING_BUCKET=dataset-platform-landing-xxxxxx

# -------------------------------------------------------------------------
# 2. GOOGLE CLOUD CONFIGURATION (Required when CLOUD_PROVIDER=gcp)
# -------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Cloud SQL Connection Name (Only needed when running on GCP Cloud Run with Cloud SQL):
CLOUD_SQL_CONNECTION_NAME=

# -------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL - Works for AWS RDS, GCP Cloud SQL, or Local)
# -------------------------------------------------------------------------
# When on AWS: DB_HOST is your RDS Address (from Terraform output: rds_address)
# When Local:  DB_HOST is 127.0.0.1
DB_HOST=data-landing-platform-db.xxxx.ap-southeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=metadata_db
DB_USER=postgres
DB_PASSWORD=DataLandingPass123!

# -------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION
# -------------------------------------------------------------------------
# Points the React web portal to your active FastAPI backend
VITE_API_URL=http://localhost:8000

# -------------------------------------------------------------------------
# 5. NOTIFICATION CHANNELS (Slack & Email Alerts)
# -------------------------------------------------------------------------
# Slack Webhooks (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_NEW_TABLE=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_JOB_COMPLETED=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_JOB_FAILED=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_DEAD_LETTER=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_QUALITY_CHECK=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH

# SMTP / Email Alerts (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
NOTIFICATION_EMAIL_SENDER=your-email@gmail.com
