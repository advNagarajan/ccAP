# =========================================================================
# SAMPLE TERRAFORM VARIABLE CONFIGURATION (AZURE)
# =========================================================================
# Copy this file to terraform.tfvars and customize for your environment:
# cp terraform.tfvars.example terraform.tfvars

resource_group_name      = "rg-data-landing-platform"
location                 = "eastus"            # or "centralindia", "westeurope", etc.
environment              = "dev"
project_name             = "datalanding"

# Storage Account Names (must be 3-24 characters, strictly lowercase letters and digits)
frontend_storage_name    = "datalandingfe"
landing_storage_name     = "datalandingraw"

# Azure Container Registry & Key Vault
acr_name                 = "datalandingacr"
keyvault_name            = "kv-datalanding"

# Service Bus
servicebus_namespace_name = "sb-datalanding-platform"

# PostgreSQL Flexible Server
postgres_server_name     = "psql-datalanding-platform"
postgres_admin_username  = "pgadmin"
postgres_admin_password  = "ChangeThisStrongPassword123!"
