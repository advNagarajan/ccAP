# Google Cloud Base (Environment-Specific)
GCP_PROJECT_ID=your-gcp-project-id

# Database (Environment-Specific / Secrets)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=metadata_db
DB_USER=your-database-user
DB_PASSWORD=your-database-password
# Google Cloud SQL connection name (Only used when running on Cloud Run with Cloud SQL attached)
CLOUD_SQL_CONNECTION_NAME=

# Slack Notification Webhooks (Secrets)
SLACK_WEBHOOK_DEAD_LETTER=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_NEW_TABLE=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_JOB_COMPLETED=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_JOB_FAILED=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
SLACK_WEBHOOK_QUALITY_CHECK=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH

# Notification Channels - SMTP (Email) Configurations (Secrets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
NOTIFICATION_EMAIL_SENDER=your-email@gmail.com

# Frontend API URL Configuration (Vite)
VITE_API_URL=http://localhost:8000
